# Build the frontend from the same source revision as the Python review server.
# The checked-in karaoke_gen/nextjs_frontend bundle can lag behind frontend/ source;
# building here prevents route logic and static page assets from getting out of sync.
FROM node:22-bookworm-slim AS frontend-build
WORKDIR /src
COPY pyproject.toml /src/pyproject.toml
COPY frontend/package.json frontend/package-lock.json ./frontend/
WORKDIR /src/frontend
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
# Regression tests for the locale-prefixed route and non-standard Docker host ports.
RUN npx jest lib/__tests__/job-router-routes.test.ts lib/__tests__/local-mode.test.ts --runInBand
RUN npm run build

# Lightweight runtime for supplied LRC + already-separated audio + human timing review.
# It intentionally does not install the AI transcription or audio-separation stack.
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    NLTK_DATA=/usr/share/nltk_data \
    USE_AGENTIC_AI=0 \
    LYRICS_REVIEW_HOST=0.0.0.0 \
    LYRICS_REVIEW_PORT=8000 \
    LYRICS_REVIEW_OPEN_BROWSER=0

WORKDIR /app

# FFmpeg is used for audio conversion and CDG/MP3 processing.
# Noto fonts are used by the lyric and CDG renderers.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg \
      libsndfile1 \
      libsox-dev \
      sox \
      fontconfig \
      fonts-noto-core \
      fonts-noto-cjk \
      fonts-noto-extra \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-lrc.txt /tmp/requirements-lrc.txt
RUN pip install --no-cache-dir -r /tmp/requirements-lrc.txt \
    && python -m spacy download en_core_web_sm \
    && python -m nltk.downloader -d /usr/share/nltk_data cmudict

# Copy the CLI package, then replace its possibly stale checked-in static frontend
# with the build produced from frontend/ above.
COPY karaoke_gen /app/karaoke_gen
COPY --from=frontend-build /src/frontend/out /app/karaoke_gen/nextjs_frontend/out
COPY pyproject.toml README.md LICENSE /app/
RUN mkdir -p /app/backend && touch /app/backend/__init__.py \
    && pip install --no-cache-dir --no-deps -e /app \
    && python -m compileall -q /app/karaoke_gen

# Fail the image build if an AI/audio-separation dependency has slipped back in,
# or if the actual LRC, review-server, frontend routes and CDG imports are broken.
RUN python - <<'PY'
import importlib.util

from fastapi import FastAPI
from fastapi.testclient import TestClient
from karaoke_gen.utils.gen_cli import validate_lrc_mode_args
from karaoke_gen.lyrics_transcriber.review.server import ReviewServer
from karaoke_gen.lyrics_transcriber.output.cdg import CDGGenerator
from karaoke_gen.nextjs_frontend import get_nextjs_assets_dir

assets = get_nextjs_assets_dir()
if assets is None or not (assets / "index.html").is_file():
    raise SystemExit("The freshly built local review frontend is missing.")

review_page = assets / "en" / "app" / "jobs" / "local" / "review" / "index.html"
if not review_page.is_file():
    review_page = assets / "app" / "jobs" / "local" / "review" / "index.html"
if not review_page.is_file():
    raise SystemExit(f"The packaged local review page is missing: {review_page}")

# Exercise the actual SPA routes without starting the interactive review loop.
probe = ReviewServer.__new__(ReviewServer)
probe._frontend_dir = str(assets)
probe._locales = ReviewServer._discover_locales(str(assets))
probe.lyrics_only = False
probe.app = FastAPI()
probe._register_spa_routes()
client = TestClient(probe.app)

api_response = client.get("/api")
if api_response.status_code != 200 or api_response.json().get("status") != "ok":
    raise SystemExit("The /api route is not responding correctly.")

for route in ("/app/jobs/local/review", "/en/app/jobs/local/review"):
    response = client.get(route)
    if response.status_code != 200 or "JobRouterClient" not in response.text:
        raise SystemExit(f"Local review route failed: {route} ({response.status_code})")

# Check that the browser bundle includes the updated Docker local port and the
# locale-aware route parser, rather than silently shipping the previous build.
chunks_dir = assets / "_next" / "static" / "chunks"
js_bundle = "\n".join(p.read_text(encoding="utf-8") for p in chunks_dir.glob("*.js"))
if '"3200"' not in js_bundle and "'3200'" not in js_bundle:
    raise SystemExit("The built frontend does not include local review port 3200.")
if "Page not found" not in js_bundle:
    raise SystemExit("The frontend JobRouterClient bundle is missing.")

for module in (
    "torch",
    "audio_separator",
    "whisper_timestamped",
    "transformers",
    "openai",
    "langchain",
    "anthropic",
    "ollama",
):
    if importlib.util.find_spec(module) is not None:
        raise SystemExit(f"AI dependency unexpectedly installed: {module}")

print("Fresh frontend routes, LRC CLI, human review server and CDG imports OK; AI stack absent.")
PY

WORKDIR /work
RUN mkdir -p /work
EXPOSE 8000

COPY docker/lrc-entrypoint.sh /usr/local/bin/karaoke-gen-lrc
RUN chmod 0755 /usr/local/bin/karaoke-gen-lrc

ENTRYPOINT ["/usr/local/bin/karaoke-gen-lrc"]
