# Lightweight local LRC-import + Human Review image.
# No PyTorch, audio-separator, Whisper, transformers or other model runtimes.
FROM node:22-bookworm-slim AS frontend
WORKDIR /src/frontend
COPY frontend/package*.json ./
RUN npm ci --legacy-peer-deps
COPY frontend/ ./
ENV NEXT_PUBLIC_API_URL=https://api.nomadkaraoke.com
RUN npm run build

FROM python:3.12-slim-bookworm AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    LYRICS_REVIEW_HOST=0.0.0.0 \
    LYRICS_REVIEW_PORT=8000 \
    LYRICS_REVIEW_OPEN_BROWSER=false \
    LYRICS_REVIEW_URL=http://localhost:8000/app/jobs/local/review \
    TZ=Pacific/Auckland

RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg \
      fontconfig \
      fonts-noto-core \
      fonts-noto-cjk \
      libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/karaoke-gen
COPY requirements-lrc.txt ./
RUN pip install --no-cache-dir -r requirements-lrc.txt

COPY . .
# The local review server serves the static Next.js export from this path.
RUN mkdir -p karaoke_gen/nextjs_frontend/out
COPY --from=frontend /src/frontend/out/ ./karaoke_gen/nextjs_frontend/out/

# Install the application without resolving the full AI-heavy Poetry dependency
# set; the smaller, explicit runtime dependency list was installed above.
RUN pip install --no-cache-dir --no-deps .

RUN mkdir -p /data /cache && \
    python -c "from karaoke_gen.utils.gen_cli import main; from karaoke_gen.lyrics_transcriber.lrc_import import parse_lrc_timestamp; print('LRC container imports OK')"

VOLUME ["/data", "/cache"]
WORKDIR /data
EXPOSE 8000
ENTRYPOINT ["karaoke-gen"]
